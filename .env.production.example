# COAir — Lightsail production env template
# Copy to .env.production and fill in real values. Never commit .env.production.
# chmod 600 .env.production after creating.

# === Required ===
GOOGLE_API_KEY=

# === Vector store + embeddings ===========================================
# RECOMMENDED (self-hosted, no per-vector cost): Qdrant + local embeddings.
#   - VECTOR_STORE_BACKEND=qdrant talks to the compose `qdrant` service.
#   - EMBEDDING_PROVIDER=local runs bge-base-en-v1.5 on CPU (free).
# CRITICAL: the SAME embedding model that created the vectors must embed queries.
# If you ingested with bge-base, the server MUST also use it — otherwise query
# vectors land in a different space and retrieval silently returns garbage.
VECTOR_STORE_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=coair
# Enable only after the tenant migration preflight has created every filtered
# payload index. Unindexed reads/updates then fail instead of scanning globally.
QDRANT_STRICT_MODE=false

# fastembed = ONNX bge-base (no torch) → low RAM, fits the 2 GB box. Wire-compatible
# with the sentence-transformers bge corpus. Use "local" only on a big-RAM/dev host.
EMBEDDING_PROVIDER=fastembed
LOCAL_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# --- Legacy Pinecone + Gemini embeddings (only if VECTOR_STORE_BACKEND=pinecone) ---
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=hybrid-rag

# === Optional dual-LLM ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# === Optional OCR ===
OCR_MODE=auto
OCR_LANG=eng
OCR_DPI=200
OCR_MAX_PAGES=500

# === Optional safety / cost limits ===
MAX_LLM_CALLS=12
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
CHRONOLOGY_PIPELINE_VERSION=v2
CACHE_TTL=3600

# Global LLM budget cap (USD) shared across conversations.
# When the cumulative cost reaches this value, /api/chat returns HTTP 402.
# (Legacy alias ASISTANT_USAGE_LIMIT_USD is still honoured for back-compat.)
COAIR_USAGE_LIMIT_USD=100
