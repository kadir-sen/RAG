# API Keys (required)
GOOGLE_API_KEY=your_google_api_key_here

# Optional extra LLM providers. Adding these keys alone no longer fans out
# every query to multiple models — that only happens when ENABLE_DUAL_PROVIDER
# is also true. Leave it off in production to avoid the per-query cost multiplier.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
ENABLE_DUAL_PROVIDER=false
MAX_LLM_CALLS=12
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
CHRONOLOGY_PIPELINE_VERSION=v2
CHRONOLOGY_V3_DEMO_ENABLED=true

# Vector Store Backend Selection
# "pinecone" (default, current production) | "qdrant" (self-hosted, AWS demo)
VECTOR_STORE_BACKEND=pinecone

# Pinecone (required when VECTOR_STORE_BACKEND=pinecone)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=hybrid-rag

# Qdrant (required when VECTOR_STORE_BACKEND=qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=constructioniq

# Authentication (required)
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_TTL_DAYS=7

# OCR Settings (optional)
OCR_MODE=auto
OCR_LANG=eng
OCR_DPI=200

# OCR Detection Thresholds (optional)
OCR_MIN_CHARS=30
OCR_MIN_ALPHA_RATIO=0.2
OCR_IMAGE_COVERAGE=0.7
OCR_MAX_PAGES=500
